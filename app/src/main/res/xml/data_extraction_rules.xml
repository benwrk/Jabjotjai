<?xml version="1.0" encoding="utf-8"?><!--
   Raw recordings never go to a cloud backup: the specification keeps data on the phone
   (docs/spec.md). The manifest also sets allowBackup="false"; this exclusion covers devices on
   which that setting does not reach every kind of transfer
   (developer.android.com/identity/data/autobackup, read 2026-11-27).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="raw/" />
    </cloud-backup>
</data-extraction-rules>
